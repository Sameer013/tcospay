<?php

// Change this to your actual database connection details, also remove .example from the filename when you save it.
$host = "localhost";
$port = "3306";
$database = "dbname";
$username = "dbusername";
$password = "dbpassword";

$dsn = 'mysql:host=' . $host . ';port=' . $port . ';dbname=' . $database;

try {
    $db = new PDO($dsn, $username, $password);
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
    // The code relies on MySQL's loose GROUP BY behaviour (as on XAMPP/MariaDB), so turn off ONLY_FULL_GROUP_BY for this connection.
    $db->exec("SET SESSION sql_mode = TRIM(BOTH ',' FROM REPLACE(REPLACE(@@SESSION.sql_mode, 'ONLY_FULL_GROUP_BY', ''), ',,', ','))");
} catch (PDOException $e) {
    echo 'Connection failed: ' . $e->getMessage();
}
